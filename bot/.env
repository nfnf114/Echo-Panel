# ==========================================
# إعدادات بوت الديسكورد (Echo Store Bot)
# ==========================================

# 1. توكن البوت الخاص بك (احصل عليه من موقع Discord Developer Portal)
# 2. آيدي رتبة الإدارة (الأشخاص الذين يمتلكون هذه الرتبة فقط يمكنهم استخدام الأوامر)
ADMIN_ROLE_ID=1503836391128432723

# 3. آيدي السيرفر (اختياري - لتحديث الأوامر فوراً وتجنب التكرار)
GUILD_ID=1503475637850079337

# ==========================================
# إعدادات الاتصال بقاعدة البيانات واللوحة
# ==========================================

# 4. رابط الباك إند (API) الذي قمنا ببرمجته (اتركه كما هو إذا كان على نفس الجهاز)
API_URL=http://localhost:3001

# 5. كلمة السر المشفرة بين البوت واللوحة (يجب أن تكون متطابقة في ملف الباك إند)
BOT_SECRET=super_secret_bot_key

# 6. رابط المتجر الخاص بك (ليظهر أسفل رسالة الـ Embed)
STORE_URL=store.Echo.com

# 7. اسم السكربت أو اللوحة (ليظهر في رسالة الـ Embed)
RESOURCE_NAME=Echo Panel - Premium

# ==========================================
# إعدادات تسجيل الدخول بالديسكورد للوحة التحكم (Discord OAuth2)
# ==========================================

# 8. الكلاينت آيدي الخاص بالبوت (Client ID)
DISCORD_CLIENT_ID=1503833838147600546

# 9. الكلاينت سيكريت الخاص بالبوت (Client Secret)
DISCORD_CLIENT_SECRET=oBauGZoXujZhQ960sZoJP7s5ODFPAtzS
