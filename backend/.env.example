# ╔══════════════════════════════════════════════════════════╗
# ║          Echo Panel — Environment Configuration         ║
# ║               https://panel.Echo.com                   ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Server ───────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://panel.Echo.com

# ─── Discord OAuth2 ───────────────────────────────────────────
# احصل عليها من: https://discord.com/developers
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://panel.Echo.com/api/auth/discord/callback

# ─── Discord Bot ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID
DISCORD_GUILD_ID=YOUR_SERVER_ID

# ─── JWT ──────────────────────────────────────────────────────
# غيّر هذا لكلمة سر قوية عشوائية
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY_MINIMUM_32_CHARS

# ─── Database (panel.db) ──────────────────────────────────────
# قاعدة بيانات اللوحة نفسها (تتولد تلقائياً)
# لا تغير هذا عادةً
DB_PATH=./db/panel.db
